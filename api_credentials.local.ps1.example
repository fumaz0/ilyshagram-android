# Copy to api_credentials.local.ps1 and fill in from https://my.telegram.org/apps
# api_credentials.local.ps1 is gitignored and must not be committed.
# You can also place one shared file in the parent owpengram/ folder for both clients.

$TDESKTOP_API_ID = 'YOUR_API_ID'
$TDESKTOP_API_HASH = 'YOUR_API_HASH'
